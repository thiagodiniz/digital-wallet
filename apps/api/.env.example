PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# User tokens signed with asymmetric keys (ES256/RS256, the current Supabase default)
# are verified via ${SUPABASE_URL}/auth/v1/.well-known/jwks.json automatically.
# Only set this if your project still issues legacy HS256 tokens (Settings -> API -> JWT Secret).
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Shared secret used by other microservices to call /internal/* endpoints.
SERVICE_JWT_SECRET=change-me
# Comma-separated list of trusted `iss` claims.
SERVICE_JWT_ISSUERS=payments-service,ledger-service
SERVICE_JWT_AUDIENCE=wallet-api
