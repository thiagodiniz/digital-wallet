PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Settings -> API -> JWT Secret. Used to verify end-user access tokens.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Shared secret used by other microservices to call /internal/* endpoints.
SERVICE_JWT_SECRET=change-me
# Comma-separated list of trusted `iss` claims.
SERVICE_JWT_ISSUERS=payments-service,ledger-service
SERVICE_JWT_AUDIENCE=wallet-api
